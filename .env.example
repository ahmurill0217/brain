# Copy to .env and edit. Every BRAIN_ variable maps to a field on BrainSettings.

# --- Secrets -----------------------------------------------------------------
# Change before anything but a laptop.
OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!
# Optional bearer token for the brain API. Unset means no auth, which is only
# reasonable when nothing but your own backend can reach the port.
BRAIN_API_KEY=

# --- Host ports --------------------------------------------------------------
# Defaults avoid the common OpenSearch and web ports (9200, 3000).
OPENSEARCH_HOST_PORT=9201
BRAIN_API_HOST_PORT=8100

# --- Access ------------------------------------------------------------------
# true  a document ingested without permissions is visible to everyone (the
#       right default for a uniformly readable corpus)
# false such a document is visible to nobody until permissions are supplied
BRAIN_DEFAULT_DOCUMENT_PUBLIC=true

# --- Vertex AI ---------------------------------------------------------------
# Both models run on Vertex, authenticated with Application Default
# Credentials: locally `gcloud auth application-default login`, in a
# deployment a service account. Empty project means the one your credentials
# belong to.
BRAIN_VERTEX_PROJECT=
BRAIN_VERTEX_LOCATION=us-central1
# Path inside the container to the credentials file, which a
# docker-compose.override.yml mounts. See the README.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/adc.json

# --- LLM ---------------------------------------------------------------------
# A Gemini model id. Only needed for answering: ingest and search work without
# it, and query expansion and section selection simply switch off.
BRAIN_LLM_MODEL=gemini-2.5-pro
# Some Gemini models are served only from "global". Empty uses the location above.
BRAIN_LLM_LOCATION=

# --- Embeddings --------------------------------------------------------------
# Changing either of these means re-indexing every document.
# BRAIN_EMBEDDING_MODEL_NAME=gemini-embedding-001
# BRAIN_EMBEDDING_DIM=768

# --- Retrieval ---------------------------------------------------------------
# Uncomment to change. See brain/config.py for what each one does.
# BRAIN_NUM_RETURNED_HITS=50
# BRAIN_MAX_CHUNKS_FED_TO_CHAT=25
# BRAIN_QUERY_EXPANSION_ENABLED=true
# BRAIN_SECTION_SELECTION_ENABLED=true
# BRAIN_SECTION_EXPANSION_ENABLED=false
