# Copy to .env and edit. Every BRAIN_ variable maps to a field on BrainSettings.

# --- Secrets -----------------------------------------------------------------
# Change before anything but a laptop.
OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!
# Optional bearer token for the brain API. Unset means no auth, which is only
# reasonable when nothing but your own backend can reach the port.
BRAIN_API_KEY=

# --- Host ports --------------------------------------------------------------
# Defaults avoid the common OpenSearch, MinIO, and web ports (9200, 9000, 3000).
OPENSEARCH_HOST_PORT=9201
MODEL_SERVER_HOST_PORT=9100
BRAIN_API_HOST_PORT=8100

# --- Access ------------------------------------------------------------------
# true  a document ingested without permissions is visible to everyone (the
#       right default for a uniformly readable corpus)
# false such a document is visible to nobody until permissions are supplied
BRAIN_DEFAULT_DOCUMENT_PUBLIC=true

# --- LLM ---------------------------------------------------------------------
# Only needed for answering. Ingest and search work without it, and the query
# expansion and section selection steps simply switch off.
BRAIN_LLM_PROVIDER=vertex_ai
BRAIN_LLM_MODEL=gemini-2.5-pro
BRAIN_LLM_API_KEY=

# Vertex reads credentials from the environment rather than an API key. Mount
# the service account JSON into the container and point this at it.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# --- Retrieval ---------------------------------------------------------------
# Uncomment to change. Defaults match the configuration we benchmarked.
# BRAIN_NUM_RETURNED_HITS=50
# BRAIN_MAX_CHUNKS_FED_TO_CHAT=25
# BRAIN_QUERY_EXPANSION_ENABLED=true
# BRAIN_SECTION_SELECTION_ENABLED=true
# BRAIN_SECTION_EXPANSION_ENABLED=false
